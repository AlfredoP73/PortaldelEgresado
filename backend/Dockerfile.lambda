FROM public.ecr.aws/lambda/python:3.11

# Instalar dependencias unificadas de los microservicios + adaptador Mangum ASGI -> AWS Lambda
RUN pip install --no-cache-dir \
    mangum==0.17.0 \
    fastapi==0.104.1 \
    uvicorn==0.24.0.post1 \
    sqlalchemy==2.0.23 \
    psycopg2-binary==2.9.9 \
    pydantic==2.5.2 \
    pydantic-settings==2.1.0 \
    python-dotenv==1.2.1 \
    "python-jose[cryptography]==3.3.0" \
    bcrypt==4.0.1 \
    "passlib[bcrypt]==1.7.4" \
    python-multipart==0.0.6 \
    email-validator==2.1.0 \
    httpx==0.26.0 \
    pika==1.3.2 \
    circuitbreaker==2.0.0 \
    boto3 \
    pypdf==4.2.0 \
    pdfplumber==0.11.0 \
    websockets==12.0 \
    "firebase-admin>=6.4.0"

# Copiar código fuente y script semilla init.sql dentro de /var/task (${LAMBDA_TASK_ROOT})
COPY ./app ${LAMBDA_TASK_ROOT}/app
COPY ./init.sql ${LAMBDA_TASK_ROOT}/init.sql

# Cada función Lambda sobrescribe el handler vía ImageConfig.Command:
# - app.lambda_handlers.auth_handler
# - app.lambda_handlers.graduates_handler
# - app.lambda_handlers.companies_handler
# - app.lambda_handlers.matchmaking_handler
# - app.lambda_handlers.dashboard_handler
# - app.lambda_handlers.cv_processor_handler
CMD ["app.lambda_handlers.auth_handler"]

